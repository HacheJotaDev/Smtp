# =====================================================================
# .env — SECRETS de Docker Compose (Mautic + MySQL)
# Copia este archivo a `.env`, rellena las contraseñas y NUNCA lo commitees
# (ya está en .gitignore). Genera contraseñas fuertes, por ejemplo con:
#   openssl rand -base64 24
# =====================================================================

MYSQL_DATABASE=mautic
MYSQL_USER=mautic
MYSQL_PASSWORD=__RELLENAR_CONTRASENA_SEGURA__
MYSQL_ROOT_PASSWORD=__RELLENAR_CONTRASENA_SEGURA__

# Notas:
# - La BD no publica puertos: solo es accesible dentro de la red interna
#   de Docker (ver compose.yaml, red 172.20.0.0/24).
# - El contenedor de Mautic recibe estas credenciales vía compose.yaml.
