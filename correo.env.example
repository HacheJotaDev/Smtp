# =====================================================================
# correo.env — variables del SISTEMA (sin secretos) usadas por
# scripts/renderizar-plantillas.sh para generar las configuraciones reales.
#
# Copia a `correo.env`, rellena y NUNCA commitees correo.env (gitignore).
# Todos los valores marcados __RELLENAR__ son obligatorios.
# No inventes valores: usa tu dominio real, tu IP real y el PTR que
# configure tu proveedor (ver docs/02-dns.md).
# =====================================================================

# Dominio del remitente (zona DNS), sin www ni http. Ej: ejemplo.com
DOMINIO=__RELLENAR__

# FQDN del servidor de correo. DEBE coincidir con el registro A y con el
# PTR (DNS inverso) que configure tu proveedor. Ej: mail.ejemplo.com
FQDN_HOST=__RELLENAR__

# IPv4 pública del VPS (la que PTR y A apuntan). Ej: 203.0.113.10
IP_SERVIDOR=__RELLENAR__

# Dirección de contacto del administrador (alertas, rua de DMARC,
# cuenta de certbot). Ej: postmaster@ejemplo.com
CORREO_POSTMASTER=__RELLENAR__

# Selector DKIM (puedes dejar mta1 o cambiarlo; menor a 64 chars, [a-zA-Z0-9._-])
SELECTOR_DKIM=mta1

# ===== Red interna de Docker (no cambiar salvo conflicto real) =====
# Subred fija para que Postfix pueda permitir relay solo a esta red (mynetworks).
RED_DOCKER_CIDR=172.20.0.0/24
# Gateway de esa red: dirección del HOST para los contenedores
# (host.docker.internal resuelve aquí vía extra_hosts en compose.yaml).
GW_DOCKER=172.20.0.1

# Puerto local donde escucha Mautic en el host (solo 127.0.0.1)
PUERTO_MAUTIC_LOCAL=8080

# Buzón de rebotes: usuario local + alias del envelope sender.
# El MAIL FROM de las campañas será  DIRECCION_REBOTES@DOMINIO
USUARIO_REBOTES=rebotes
DIRECCION_REBOTES=devolucion

# ===== Rutas =====
# Directorio donde clonaste este repositorio en el VPS.
DIR_BASE=/opt/campanas

# ===== Firewall =====
# IPs administrativas con permiso SSH (recomendado). Lista separada por
# espacios en notación CIDR. Deja vacío para permitir SSH desde cualquier
# IP (menos seguro). Ej: 203.0.113.10/32 198.51.100.0/24
IPS_ADMIN_UFW=

# ===== Envío =====
# Lote máximo por ejecución de mautic:email:send (cron cada 5 min).
# Empieza BAJO durante el calentamiento (ver docs/04-entregabilidad.md).
LOTE_EMAILS=50
