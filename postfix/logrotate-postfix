# =====================================================================
# /etc/logrotate.d/postfix-correo — rotación de logs de correo
# Instalada por scripts/20-postfix.sh. Complementa la rotación del
# sistema sin tocar la de Ubuntu (rsyslog).
# =====================================================================
/var/log/mail.log
/var/log/mail.err
/var/log/campanas/*.log
{
    daily
    rotate 28
    missingok
    notifempty
    compress
    delaycompress
    dateext
    sharedscripts
    create 640 syslog adm
    postrotate
        if [ -x /usr/lib/rsyslog/rsyslog-rotate ]; then
            /usr/lib/rsyslog/rsyslog-rotate
        fi
    endscript
}
